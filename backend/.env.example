APP_NAME=DocuMind AI API
APP_ENV=development
APP_HOST=127.0.0.1
# Informational only: the port is chosen by `uvicorn --port` (run.bat uses 8001)
APP_PORT=8000
# One origin, or several separated by commas
FRONTEND_ORIGIN=http://localhost:5173

# Confirm host/port/username/password in your XAMPP setup. YOUR_PASSWORD is a placeholder.
# If local root has an empty password: mysql+pymysql://root:@127.0.0.1:3306/documind_ai?charset=utf8mb4 (development only)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/documind_ai?charset=utf8mb4

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM_PROVIDER: anthropic | openai | ollama | mock
#   ollama = free, runs on your own computer, no API key (install Ollama, run `ollama pull llama3.2:3b`,
#   set LLM_MODEL=llama3.2:3b and raise LLM_TIMEOUT_SECONDS because CPU-only answers can take a minute).
#   mock is DEVELOPMENT-ONLY: answers are labelled "[DEVELOPMENT MOCK - not a real AI answer]".
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Only for openai-compatible providers (defaults to https://api.openai.com/v1)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
# Shorter answers and a repetition penalty help small local models (e.g. 350 and 0.3).
LLM_MAX_TOKENS=1024
LLM_FREQUENCY_PENALTY=0

# EMBEDDING_PROVIDER: sentence_transformers | hashing (hashing = tiny dev/test embedder, weak quality)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RESULTS=5
RETRIEVAL_MIN_SIMILARITY=0.05

# Background processing. The API runs one worker thread by default; for a separate worker process set
# WORKER_EMBEDDED=false and run `python -m app.worker` (several workers are safe).
WORKER_EMBEDDED=true
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=15
JOB_STALE_AFTER_SECONDS=600
MAX_PDF_PAGES=1000
MULTI_DOC_MAX_SOURCES=8
MAX_DOCUMENTS_PER_QUESTION=20

# Search ranking (all optional). Hybrid = reciprocal rank fusion of keyword and semantic passage lists.
SEARCH_RRF_K=60
SEARCH_KEYWORD_WEIGHT=1.0
SEARCH_SEMANTIC_WEIGHT=1.0
SEARCH_CANDIDATES=100

# Content review / conflict detection (optional)
REVIEW_DUE_SOON_DAYS=14
CONFLICT_MIN_SIMILARITY=0.5
CONFLICT_MAX_PAIRS=12
CONFLICT_MAX_PASSAGES=40
CONFLICT_NEIGHBOURS=3
